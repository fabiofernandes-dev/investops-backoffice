{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PositionUpdated v1",
  "description": "Evento publicado pelo worker quando a posição consolidada é atualizada.",
  "type": "object",
  "required": ["eventId", "eventType", "version", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "const": "PositionUpdated" },
    "version": { "type": "integer", "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "payload": {
      "type": "object",
      "required": ["accountId", "productId", "quantity", "averagePrice", "grossAmount"],
      "properties": {
        "accountId": { "type": "string", "format": "uuid" },
        "productId": { "type": "string", "format": "uuid" },
        "quantity": { "type": "number" },
        "averagePrice": { "type": "number" },
        "grossAmount": { "type": "number" }
      }
    }
  }
}
