{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=investops;Username=investops;Password=investops"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "investops",
