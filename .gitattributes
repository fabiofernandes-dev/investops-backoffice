# Normalize line endings: repo stores LF, checkout native on Windows
* text=auto

# Force LF for files consumed by Linux containers / shell
*.sh         text eol=lf
Dockerfile   text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.sql        text eol=lf

# Force CRLF for Windows-native scripts
*.ps1        text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf

# Treat as binary (no diff/merge)
*.png        binary
*.jpg        binary
*.ico        binary
