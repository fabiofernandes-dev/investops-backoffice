# Credenciais de DESENVOLVIMENTO LOCAL (docker compose de demonstração).
# Os defaults funcionais são intencionais: `docker compose up` deve subir o
# stack completo sem nenhuma edição — este é o objetivo do repositório.
# Qualquer deploy fora da máquina local deve sobrescrever estes valores
# (o compose lê deste arquivo; a API também aceita variáveis de ambiente,
# ver README "Ambientes (API)").

# PostgreSQL
POSTGRES_USER=investops
POSTGRES_PASSWORD=investops
POSTGRES_DB=investops
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=investops
RABBITMQ_PASSWORD=investops
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
